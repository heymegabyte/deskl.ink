{
  "name": "deskl.ink",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop for you. A computer for your AI. Instantly available, browser-accessible Linux workstations operable by humans and AI agents — Cloudflare-native.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.28.0"
  },
  "scripts": {
    "dev": "pnpm --filter @deskl/web dev",
    "dev:api": "pnpm --filter @deskl/api dev",
    "build": "pnpm --filter @deskl/web build",
    "build:all": "pnpm -r build",
    "preview": "pnpm --filter @deskl/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "durable-objects",
    "containers",
    "desktop",
    "ai-agents",
    "remote-workstation",
    "linux"
  ],
  "author": {
    "name": "Brian Zalewski",
    "email": "brian@megabyte.space"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
