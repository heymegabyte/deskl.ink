# deskl.ink environment template — copy to .env and fill in. NEVER commit real values.

# --- Cloudflare ---
# Your Cloudflare account id (dash.cloudflare.com → right sidebar → Account ID).
CLOUDFLARE_ACCOUNT_ID=

# --- Auth (Better Auth, lands in Milestone 2) ---
# 32-byte random secret used to sign sessions: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Canonical base URL of the app, e.g. https://deskl.ink (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# --- OAuth: GitHub (github.com/settings/developers → New OAuth App) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth: Google (console.cloud.google.com → Credentials → OAuth client ID) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing: Stripe (dashboard.stripe.com/test/apikeys — use TEST keys in dev) ---
# Secret key (server-side). Starts with sk_test_ in test mode.
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe CLI or dashboard endpoint. Starts with whsec_.
STRIPE_WEBHOOK_SECRET=
# Publishable key (client-side). Starts with pk_test_ in test mode.
STRIPE_PUBLISHABLE_KEY=

# --- Transactional email: Resend (resend.com/api-keys) ---
# API key for sending auth + billing emails. Starts with re_.
RESEND_API_KEY=
