#!/bin/sh
# -----------------------------------------------------------------------------
# deskl.ink — TigerVNC xstartup (runs inside the X server on display :1)
# -----------------------------------------------------------------------------
# Xtigervnc execs this script once the X server is up. Its job: establish the
# environment GNOME needs, dress the root window in deskl.ink near-black,
# quiet X power-management, apply the same deskl.ink mark used by GitHub and the
# website, and hand off to a full GNOME session.
#
# GNOME-over-Xvnc needs a private D-Bus session and XDG runtime directory:
#   1. `dbus-run-session` creates the bus used by GNOME Shell and settings.
#   2. XDG_RUNTIME_DIR must exist with 0700 perms — GNOME writes sockets
#      there. The container has no systemd/elogind to create /run/user/<uid>, so
#      we provision /tmp/runtime-desklink ourselves.
#   3. XDG_SESSION_TYPE=x11 forces GNOME's X11 path under TigerVNC.
# -----------------------------------------------------------------------------
set -e

# Make sure the session agrees on which display it is painting.
export DISPLAY="${DISPLAY:-:1}"

# --- Fresh D-Bus: drop anything inherited so GNOME starts its own bus. ----------
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS

# --- XDG runtime dir (0700) — GNOME needs a private socket dir. ----------------
# No systemd/elogind here to create /run/user/<uid>, so provision it ourselves.
XDG_RUNTIME_DIR="/tmp/runtime-desklink"
export XDG_RUNTIME_DIR
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

# --- Tell GNOME this is an X11 session (not Wayland). --------------------------
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_DESKTOP=gnome
export DESKTOP_SESSION=gnome
# Legacy toggle some stacks still read; harmless, avoids an xmodmap hiccup.
export XKL_XMODMAP_DISABLE=1
# Force software GL for any stray GL client — there is no GPU in the container.
export LIBGL_ALWAYS_SOFTWARE=1

# --- deskl.ink backdrop floor: solid near-black (#05060A). --------------------
# GNOME repaints this once settings load; this covers the brief pre-paint window.
if command -v xsetroot >/dev/null 2>&1; then
  xsetroot -solid "#05060A"
fi

# --- Headless display hygiene: never blank / power-save (no physical monitor). -
if command -v xset >/dev/null 2>&1; then
  xset s off || true        # no screensaver
  xset -dpms || true        # no DPMS power-management blanking
  xset s noblank || true    # never blank the framebuffer
fi

# --- Apply brand settings and hand off to GNOME under a fresh D-Bus session. ----
if command -v dbus-run-session >/dev/null 2>&1; then
  exec dbus-run-session -- sh -lc '
    gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
    gsettings set org.gnome.desktop.background picture-uri file:///usr/share/backgrounds/deskl-ink.png || true
    gsettings set org.gnome.desktop.background picture-uri-dark file:///usr/share/backgrounds/deskl-ink.png || true
    gsettings set org.gnome.desktop.background picture-options zoom || true
    gsettings set org.gnome.desktop.session idle-delay 0 || true
    exec gnome-session --session=gnome
  '
else
  # Fallback for images without dbus-run-session.
  eval "$(dbus-launch --sh-syntax)"
  export DBUS_SESSION_BUS_ADDRESS DBUS_SESSION_BUS_PID
  exec gnome-session --session=gnome
fi
