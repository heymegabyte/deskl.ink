# deskl.ink — KDE global theme (pre-baked into ~/.config/kdeglobals)
# -----------------------------------------------------------------------------
# Opens the desktop DARK + on-brand on first boot, with NO trip through System
# Settings. KDE applies a color scheme by copying the scheme's .colors file into
# kdeglobals — so the full Breeze Dark [Colors:*] groups are inlined below
# (sourced from /usr/share/color-schemes/BreezeDark.colors on noble, Plasma
# 5.27). The deskl.ink cyan (#00E5FF = 0,229,255) is applied as the accent and
# as the selection/hover highlight so the dark surface reads intentional, not
# default-gray.
# -----------------------------------------------------------------------------

[General]
ColorScheme=BreezeDark
# deskl.ink cyan accent. (Noble's Plasma 5.27 honours AccentColor when a scheme
# is active; harmless where ignored — the explicit DecorationFocus/Hover and
# Selection colors below carry the cyan regardless.)
AccentColor=0,229,255
LookAndFeelPackage=org.kde.breezedark.desktop
Name=deskl.ink Dark
shadeSortColumn=true
# Dark, crisp default fonts (Noto ships in the image).
font=Noto Sans,10,-1,5,50,0,0,0,0,0
fixed=Noto Sans Mono,10,-1,5,50,0,0,0,0,0
menuFont=Noto Sans,10,-1,5,50,0,0,0,0,0
smallestReadableFont=Noto Sans,8,-1,5,50,0,0,0,0,0
toolBarFont=Noto Sans,10,-1,5,50,0,0,0,0,0

[KDE]
# Widget style. Breeze is installed with Plasma; dark colors come from the
# scheme groups below. SingleClick=false → desktop users expect double-click.
widgetStyle=Breeze
SingleClick=false
contrast=4
AnimationDurationFactor=0

